# Copy to .env and adjust. Nothing in the codebase hardcodes these values.

# --- Mongo -------------------------------------------------------------------
MONGO_URI=mongodb://root:example@localhost:27017
MONGO_DATABASE=wrc
MONGO_LANDING_COLLECTION=landing_decisions
MONGO_CURATED_COLLECTION=curated_decisions
MONGO_OBSERVATIONS_COLLECTION=record_observations
MONGO_FAILURES_COLLECTION=failed_records
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=example

# --- Object storage ----------------------------------------------------------
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_LANDING_BUCKET=landing-zone
S3_CURATED_BUCKET=curated-zone
S3_REGION=us-east-1

# --- Scraping ----------------------------------------------------------------
# Which registered source adapter to use (see scraping/search_adapter.py).
SCRAPE_SOURCE=wrc
SCRAPE_BASE_URL=https://www.workplacerelations.ie
SCRAPE_PARTITION_SIZE=monthly
SCRAPE_CONCURRENT_REQUESTS=8
SCRAPE_CONCURRENT_REQUESTS_PER_DOMAIN=4
SCRAPE_DOWNLOAD_DELAY_SECONDS=0.25
SCRAPE_AUTOTHROTTLE_ENABLED=true
SCRAPE_OBEY_ROBOTS_TXT=true
SCRAPE_RETRY_TIMES=4
# Pipe-separated. Omit to crawl all four bodies.
SCRAPE_BODIES=Workplace Relations Commission|Labour Court|Equality Tribunal|Employment Appeals Tribunal
# 0 = unlimited; set to e.g. 20 for a fast smoke test.
SCRAPE_MAX_RECORDS_PER_PARTITION=0
# Circuit breaker on pagination depth; hitting it marks the partition partial.
SCRAPE_MAX_PAGES_PER_PARTITION=500
# false (default): records already landed are skipped at LISTING time -- their
# pages are never re-downloaded. true: re-fetch and hash-compare known records
# to detect silently amended decisions (use for a scheduled amendment sweep).
SCRAPE_RECHECK_KNOWN=false
# Development convenience: cache HTTP responses on disk between runs.
SCRAPE_HTTPCACHE_ENABLED=false

# --- Orchestration -------------------------------------------------------------
# Earliest monthly partition exposed for backfill.
ORCH_PARTITION_START_DATE=2015-10-01
# Hard ceiling for one partition's crawl subprocess (seconds).
ORCH_CRAWL_TIMEOUT_SECONDS=3600
# Nightly current-month refresh (new records only; re-downloads nothing).
ORCH_REFRESH_CRON=0 2 * * *
# Weekly amendment sweep (re-fetches known records with --recheck-known).
ORCH_SWEEP_CRON=0 3 * * 0
ORCH_TIMEZONE=Europe/Dublin

# --- Transformation ------------------------------------------------------------
# Mongo read/write batch size. Document payloads stay bounded; latest-version
# resolution still holds ~100 bytes per record in the window (see ARCHITECTURE.md).
TRANSFORM_BATCH_SIZE=200

# --- Run ---------------------------------------------------------------------
RUN_START_DATE=2024-01-01
RUN_END_DATE=2025-01-01
RUN_LOG_LEVEL=INFO
RUN_LOG_FORMAT=json
